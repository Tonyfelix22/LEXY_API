{
  "compilerOptions": {
    /* ==== Module + Target ==== */
    "target": "ESNext",                     // modern output for better tree-shaking
    "module": "ESNext",
    "moduleResolution": "Bundler",

    /* ==== Language & Environment ==== */
    "lib": ["DOM", "DOM.Iterable", "ESNext"],

    /* ==== React / JSX ==== */
    "jsx": "preserve",                      // Next.js compiles JSX itself
    "allowJs": true,                        // allows JS files too

    /* ==== Type Checking ==== */
    "strict": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "noEmit": true,                         // don’t emit .js output
    "incremental": true,                    // speed up recompile

    /* ==== Module Interop ==== */
    "esModuleInterop": true,
    "resolveJsonModule": true,

    /* ==== Path Aliases ==== */
    "baseUrl": ".",                         // required for "@/..." to work
    "paths": {
      "@/*": ["./*"]
    },

    /* ==== Next.js Plugin ==== */
    "plugins": [
      { "name": "next" }
    ]
  },

  /* ==== Included Files ==== */
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts"
  ],

  /* ==== Excluded ==== */
  "exclude": ["node_modules"]
}
